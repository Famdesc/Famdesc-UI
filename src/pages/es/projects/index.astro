---
import MainLayout from "@/layouts/MainLayout.astro";
import { projects } from "@data/projects";
import { SITE } from "@data/constants";

const pageTitle = `Proyectos reales y soluciones digitales | ${SITE.title}`;
const pageDescription =
  "Conoce proyectos digitales desarrollados por Famdesc para negocios reales: el problema, la solución construida y el resultado en producción.";

const accentClasses = {
  salmon:
    "from-salmon-500/30 via-salmon-400/10 to-transparent text-salmon-600 dark:text-salmon-400",
  blue: "from-blue-500/30 via-blue-400/10 to-transparent text-blue-600 dark:text-blue-300",
  amber:
    "from-amber-500/30 via-amber-400/10 to-transparent text-amber-700 dark:text-amber-300",
};

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Proyectos de Famdesc",
  description: pageDescription,
  url: `${SITE.url}/es/projects`,
  inLanguage: "es",
  hasPart: projects.map((project) => ({
    "@type": "CreativeWork",
    name: project.name,
    url: `${SITE.url}/es/projects/${project.slug}`,
  })),
};
---

<MainLayout
  title={pageTitle}
  meta={pageDescription}
  lang="es"
  structuredData={structuredData}
>
  <section
    class="relative overflow-hidden px-4 pb-16 pt-20 sm:px-6 lg:px-8 lg:pb-24 lg:pt-28"
  >
    <div
      class="pointer-events-none absolute inset-x-0 top-0 -z-10 mx-auto h-96 max-w-5xl rounded-full bg-salmon-400/10 blur-3xl dark:bg-salmon-500/10"
    >
    </div>
    <div class="mx-auto max-w-4xl text-center">
      <p
        class="mb-5 text-sm font-semibold uppercase tracking-[0.2em] text-salmon-600 dark:text-salmon-400"
      >
        Portafolio Famdesc
      </p>
      <h1
        class="text-balance text-4xl font-bold tracking-tight text-neutral-800 dark:text-neutral-100 sm:text-5xl lg:text-7xl"
      >
        Soluciones digitales que ya trabajan para negocios reales.
      </h1>
      <p
        class="mx-auto mt-7 max-w-3xl text-pretty text-lg leading-8 text-neutral-600 dark:text-neutral-300 sm:text-xl"
      >
        Cada proyecto comienza con un problema concreto. Aquí mostramos cómo lo
        entendimos, qué construimos y cómo convertimos la solución en una
        experiencia lista para producción.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-[85rem] px-4 pb-20 sm:px-6 lg:px-8 lg:pb-28">
    <div class="grid gap-7 lg:grid-cols-2">
      {
        projects.map((project, index) => (
          <article
            class:list={[
              "group overflow-hidden rounded-3xl border border-neutral-300 bg-neutral-100/60 transition duration-300 hover:-translate-y-1 hover:shadow-xl dark:border-neutral-700 dark:bg-neutral-900/30",
              index === 0 && "lg:col-span-2",
            ]}
          >
            <div
              class:list={[
                "relative overflow-hidden bg-gradient-to-br p-7 sm:p-10",
                accentClasses[project.accent],
              ]}
            >
              <div class="absolute -right-12 -top-12 size-48 rounded-full border border-current opacity-10" />
              <div class="absolute -right-4 top-8 size-28 rounded-full border border-current opacity-10" />
              <div class="relative flex min-h-52 flex-col justify-between">
                <div class="flex items-center justify-between gap-4">
                  <span class="border-current/20 rounded-full border bg-white/50 px-3 py-1 text-xs font-semibold uppercase tracking-wider dark:bg-neutral-900/40">
                    {project.eyebrow}
                  </span>
                  <span class="font-mono text-sm opacity-70">0{index + 1}</span>
                </div>
                <div>
                  <p class="mb-2 text-sm font-semibold uppercase tracking-widest opacity-80">
                    {project.type}
                  </p>
                  <h2 class="text-balance text-3xl font-bold text-neutral-800 dark:text-neutral-100 sm:text-4xl">
                    {project.name}
                  </h2>
                </div>
              </div>
            </div>
            <div class="p-7 sm:p-10">
              <p class="text-lg leading-8 text-neutral-600 dark:text-neutral-300">
                {project.summary}
              </p>
              <div class="mt-6 flex flex-wrap gap-2">
                {project.technologies.slice(0, 4).map((technology) => (
                  <span class="rounded-full bg-neutral-200 px-3 py-1 text-xs font-medium text-neutral-600 dark:bg-neutral-700 dark:text-neutral-300">
                    {technology}
                  </span>
                ))}
              </div>
              <a
                href={`/es/projects/${project.slug}`}
                class="mt-8 inline-flex items-center gap-2 font-semibold text-neutral-800 transition group-hover:gap-3 dark:text-neutral-100"
              >
                Ver caso de estudio
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-[85rem] px-4 pb-20 sm:px-6 lg:px-8 lg:pb-28">
    <div
      class="rounded-3xl bg-neutral-800 px-7 py-12 text-center text-white dark:bg-neutral-950 sm:px-12 sm:py-16"
    >
      <p
        class="text-sm font-semibold uppercase tracking-[0.2em] text-salmon-400"
      >
        ¿Tienes un proyecto en mente?
      </p>
      <h2
        class="mx-auto mt-4 max-w-3xl text-balance text-3xl font-bold sm:text-4xl"
      >
        Conversemos sobre el problema que necesitas resolver.
      </h2>
      <a
        href="/es/contact"
        class="mt-8 inline-flex rounded-lg bg-salmon-500 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-salmon-600 focus:outline-none focus-visible:ring focus-visible:ring-salmon-300"
        >Contactar con Famdesc</a
      >
    </div>
  </section>
</MainLayout>
