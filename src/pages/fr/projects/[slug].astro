---
import ProjectCaseStudyPage from "@components/pages/ProjectCaseStudyPage.astro";
import { getLocalizedProjects } from "@data/projectTranslations";
export function getStaticPaths() {
  return getLocalizedProjects("fr").map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}
const { project } = Astro.props;
---

<ProjectCaseStudyPage locale="fr" project={project} />
