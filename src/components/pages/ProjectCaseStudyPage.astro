---
import MainLayout from "@/layouts/MainLayout.astro";
import ClientTestimonials from "@components/sections/testimonials/ClientTestimonials.astro";
import { clientTestimonials } from "@data/clientTestimonials";
import type { Project } from "@data/projects";
import { SITE } from "@data/constants";

interface Props {
  locale: "en" | "fr";
  project: Project;
}
const { locale, project } = Astro.props;
const prefix = locale === "fr" ? "/fr" : "";
const copy =
  locale === "fr"
    ? {
        all: "Tous les projets",
        visit: "Voir le projet en production",
        context: "Contexte",
        challenge: "Problématique",
        result: "Résultat",
        solution: "La solution",
        solutionTitle: "Conçue autour d'un besoin réel.",
        role: "Contribution de Famdesc",
        tech: "Technologies utilisées",
        testimonial: "Un témoignage sur ce projet",
        next: "Votre projet peut être le prochain",
        nextTitle:
          "Construisons une solution claire, utile et prête pour la production.",
        contact: "Parlez-nous de votre projet",
      }
    : {
        all: "All projects",
        visit: "Visit the live project",
        context: "Context",
        challenge: "Challenge",
        result: "Result",
        solution: "The solution",
        solutionTitle: "Designed around a real need.",
        role: "Famdesc's contribution",
        tech: "Technologies used",
        testimonial: "A perspective on this project",
        next: "Your project could be next",
        nextTitle:
          "Let’s build a clear, useful solution that is ready for production.",
        contact: "Tell us what you need",
      };
const projectTestimonials = clientTestimonials.filter(
  (item) =>
    item.projectSlug === project.slug &&
    (import.meta.env.DEV || item.status === "approved"),
);
---

<MainLayout
  title={`${project.name} | ${SITE.title}`}
  meta={project.summary}
  lang={locale}
>
  <article>
    <header
      class="relative overflow-hidden px-4 pb-16 pt-16 sm:px-6 lg:px-8 lg:pb-24 lg:pt-24"
    >
      <div
        class="pointer-events-none absolute inset-x-0 top-0 -z-10 mx-auto h-96 max-w-5xl rounded-full bg-salmon-400/10 blur-3xl dark:bg-salmon-500/10"
      >
      </div>
      <div class="mx-auto max-w-5xl">
        <a
          href={`${prefix}/projects`}
          class="inline-flex items-center gap-2 text-sm font-semibold text-neutral-600 transition hover:text-salmon-600 dark:text-neutral-300 dark:hover:text-salmon-400"
          ><span aria-hidden="true">←</span> {copy.all}</a
        >
        <p
          class="mt-12 text-sm font-semibold uppercase tracking-[0.2em] text-salmon-600 dark:text-salmon-400"
        >
          {project.eyebrow} · {project.type}
        </p>
        <h1
          class="mt-4 max-w-4xl text-balance text-4xl font-bold tracking-tight text-neutral-800 dark:text-neutral-100 sm:text-6xl"
        >
          {project.name}
        </h1>
        <p
          class="mt-7 max-w-3xl text-pretty text-xl leading-9 text-neutral-600 dark:text-neutral-300"
        >
          {project.summary}
        </p>
        <a
          href={project.productionUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-9 inline-flex items-center gap-2 rounded-lg bg-neutral-800 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-neutral-700 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-white"
          >{copy.visit} <span aria-hidden="true">↗</span></a
        >
      </div>
    </header>

    <section
      class="mx-auto grid max-w-5xl gap-6 px-4 py-12 sm:px-6 lg:grid-cols-3 lg:px-8 lg:py-20"
    >
      {
        [
          [copy.context, project.context],
          [copy.challenge, project.challenge],
          [copy.result, project.result],
        ].map(([title, text]) => (
          <div class="rounded-2xl border border-neutral-300 p-6 dark:border-neutral-700">
            <>
              <p class="text-sm font-semibold uppercase tracking-wider text-salmon-600 dark:text-salmon-400">
                {title}
              </p>
              <p class="mt-4 leading-7 text-neutral-600 dark:text-neutral-300">
                {text}
              </p>
            </>
          </div>
        ))
      }
    </section>

    <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-[0.2em] text-salmon-600 dark:text-salmon-400"
          >
            {copy.solution}
          </p><h2
            class="mt-4 text-balance text-3xl font-bold text-neutral-800 dark:text-neutral-100 sm:text-4xl"
          >
            {copy.solutionTitle}
          </h2>
        </div><div>
          <p class="text-lg leading-8 text-neutral-600 dark:text-neutral-300">
            {project.solution}
          </p><ul class="mt-8 grid gap-4 sm:grid-cols-2">
            {
              project.features.map((feature) => (
                <li class="flex gap-3 text-neutral-700 dark:text-neutral-300">
                  <span class="mt-2 size-2 flex-none rounded-full bg-salmon-500" />
                  {feature}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <div
        class="rounded-3xl bg-neutral-100/70 p-7 dark:bg-neutral-900/40 sm:p-10 lg:p-14"
      >
        <div class="grid gap-12 lg:grid-cols-2">
          <div>
            <h2
              class="text-2xl font-bold text-neutral-800 dark:text-neutral-100"
            >
              {copy.role}
            </h2><ul class="mt-6 space-y-4">
              {
                project.participation.map((item) => (
                  <li class="flex gap-3 text-neutral-600 dark:text-neutral-300">
                    <span class="font-semibold text-salmon-600 dark:text-salmon-400">
                      ✓
                    </span>
                    {item}
                  </li>
                ))
              }
            </ul>
          </div><div>
            <h2
              class="text-2xl font-bold text-neutral-800 dark:text-neutral-100"
            >
              {copy.tech}
            </h2><div class="mt-6 flex flex-wrap gap-3">
              {
                project.technologies.map((technology) => (
                  <span class="rounded-full border border-neutral-300 bg-neutral-200/70 px-4 py-2 text-sm font-medium text-neutral-700 dark:border-neutral-600 dark:bg-neutral-800 dark:text-neutral-200">
                    {technology}
                  </span>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <ClientTestimonials
      testimonials={projectTestimonials}
      title={copy.testimonial}
      showProject={false}
      showDraftBadge={import.meta.env.DEV}
      locale={locale}
    />
    <section
      class="mx-auto max-w-5xl px-4 pb-20 pt-12 text-center sm:px-6 lg:px-8 lg:pb-28 lg:pt-20"
    >
      <p
        class="text-sm font-semibold uppercase tracking-[0.2em] text-salmon-600 dark:text-salmon-400"
      >
        {copy.next}
      </p><h2
        class="mx-auto mt-4 max-w-3xl text-balance text-3xl font-bold text-neutral-800 dark:text-neutral-100 sm:text-4xl"
      >
        {copy.nextTitle}
      </h2><a
        href={`${prefix}/contact`}
        class="mt-8 inline-flex rounded-lg bg-salmon-500 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-salmon-600"
        >{copy.contact}</a>
    </section>
  </article>
</MainLayout>
